# =============================================================================
# CodeGuide Environment Variables Template
# =============================================================================
# Copy this file to .env and modify the values as needed for your environment
# NEVER commit the actual .env file to version control
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
# PostgreSQL database connection string
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/postgres

# PostgreSQL configuration (used with Docker setup)
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# -----------------------------------------------------------------------------
# AUTHENTICATION CONFIGURATION
# -----------------------------------------------------------------------------
# Secret key for JWT token signing and session management
# Generate a secure 32+ character string for production
# Use: openssl rand -base64 32 (Linux/macOS) or https://generate-secret.vercel.app/32
BETTER_AUTH_SECRET=your_secret_key_here_change_this_in_production

# Base URLs for authentication callbacks and redirects
# Update these for your deployment environment
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# Additional authentication settings (optional)
# BETTER_AUTH_SESSION_EXPIRY=604800  # 7 days in seconds
# BETTER_AUTH_COOKIE_NAME=auth-session

# -----------------------------------------------------------------------------
# APPLICATION CONFIGURATION
# -----------------------------------------------------------------------------
# Node.js environment
NODE_ENV=development

# Application port (if not using default 3000)
# PORT=3000

# Application URL for building absolute URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# DEVELOPMENT CONFIGURATION
# -----------------------------------------------------------------------------
# Enable debug logging (development only)
DEBUG=false

# Enable database query logging (development only)
DATABASE_DEBUG=false

# -----------------------------------------------------------------------------
# PRODUCTION CONFIGURATION (uncomment for production)
# -----------------------------------------------------------------------------
# # Production database URL (replace with your managed PostgreSQL)
# DATABASE_URL=postgresql://username:password@your-db-host:5432/database_name

# # Production authentication URLs
# BETTER_AUTH_URL=https://yourdomain.com
# NEXT_PUBLIC_BETTER_AUTH_URL=https://yourdomain.com
# NEXT_PUBLIC_APP_URL=https://yourdomain.com

# # Production environment
# NODE_ENV=production

# # Security settings
# BETTER_AUTH_SECRET=your-very-secure-32-character-secret-for-production

# -----------------------------------------------------------------------------
# OPTIONAL INTEGRATIONS (uncomment and configure as needed)
# -----------------------------------------------------------------------------
# # Email service configuration (for password resets, etc.)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# # Analytics and monitoring
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# # File storage (for user uploads, etc.)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=your-bucket-name

# # Rate limiting
# RATE_LIMIT_MAX_REQUESTS=100
# RATE_LIMIT_WINDOW_MS=900000

# -----------------------------------------------------------------------------
# DOCKER PRODUCTION CONFIGURATION
# -----------------------------------------------------------------------------
# When using Docker Compose for production, you can use these variables:
# POSTGRES_DB=codeguide_prod
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=secure_production_password_here
# DATABASE_URL=postgresql://postgres:secure_production_password_here@postgres:5432/codeguide_prod

# =============================================================================
# SETUP INSTRUCTIONS
# =============================================================================
# 1. Copy this file to .env:
#    cp .env.example .env
#
# 2. Generate a secure secret for production:
#    openssl rand -base64 32
#
# 3. Update the DATABASE_URL for your database setup:
#    - Docker development: Use the default values above
#    - Local PostgreSQL: Update with your local credentials
#    - Production: Use your managed database connection string
#
# 4. For production deployment, update the auth URLs to your domain:
#    - BETTER_AUTH_URL=https://yourdomain.com
#    - NEXT_PUBLIC_BETTER_AUTH_URL=https://yourdomain.com
#
# 5. Never commit .env files to version control. They are already in .gitignore.
# =============================================================================